<?xml version='1.0' encoding='UTF-8'?>
<simulation name="Basic1TargetWgn">
    <parameters>
        <starttime>0</starttime>
        <endtime>180</endtime>
        <rate>204800</rate>
        <c>299792458</c>
        <simSamplingRate>1000</simSamplingRate>
        <adc_bits>16</adc_bits>
        <oversample>1</oversample>
    </parameters>
    <waveform name="TxWaveform">
        <power>16400</power>
        <carrier_frequency>89e6</carrier_frequency>
        <cw_from_file filename="../../data/waveforms/WGN_180s_204800Hz.h5" />
    </waveform>
    <waveform name="JammerWaveform">
        <power>1</power>
        <carrier_frequency>89e6</carrier_frequency>
        <cw_from_file filename="../../data/waveforms/WGN_180s_204800Hz.h5" />
    </waveform>
    <timing name="TxClock" synconpulse="true">
        <frequency>204800</frequency>
    </timing>
    <timing name="RxClock" synconpulse="true">
        <frequency>204800</frequency>
        <random_freq_offset_stdev>0.01</random_freq_offset_stdev>
    </timing>
    <timing name="JammerClock" synconpulse="true">
        <frequency>204800</frequency>
    </timing>
    <antenna name="RxYagiAntenna" pattern="sinc">
        <alpha>5.2481</alpha>
        <beta>2</beta>
        <gamma>3.6</gamma>
        <efficiency>1</efficiency>
    </antenna>
    <antenna name="TxIsoAntenna" pattern="isotropic">
        <efficiency>1</efficiency>
    </antenna>
    <antenna name="JammingIsoAntenna" pattern="isotropic">
        <efficiency>1</efficiency>
    </antenna>
    <platform name="ContantiabergTxPlatform">
        <motionpath interpolation="static">
            <positionwaypoint>
                <x>258804.41</x>
