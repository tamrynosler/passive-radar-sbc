            <azimuthrate>0</azimuthrate>
            <elevationrate>0</elevationrate>
        </fixedrotation>
        <transmitter name="ConstantiabergTx" antenna="TxIsoAntenna" waveform="TxWaveform" timing="TxClock">
            <cw_mode/>
