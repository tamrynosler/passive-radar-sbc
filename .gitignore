# Build output
build/
*.o
*.obj
*.so
*.a
cufft_bench
bin/

# CUDA / profiler artefacts
*.nvvp
*.qdrep
*.nsys-rep
*.ncu-rep
nvprof.*

# Benchmark + capture data (lives on /data, regenerated from FERS — never commit)
*.csv
*.bin
*.iq
*.dat
*.mat
*.h5
*.pbrcap
tegrastats*.log
data/
results/
# Rendered plots and movies from matlab/play_ard.m and friends -- regenerated
# from the ARD snapshots, so not worth version controlling.
*.mp4
*.png
# ...except thesis figures and input PDFs, which are source assets. See
# Report/.gitignore. The CI build fails on a clean clone without them.
!Report/figs/**
!Report/pdfs/**

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Python (if a plotting/analysis venv is used)
__pycache__/
*.pyc
.venv/
venv/

# Legacy code
legacy/
matlab/legacy/

# Agent standards + session records (local only, not for the repo or Jetson)
CLAUDE.md
PROGRESS.md
PLAN.md
